{
  "name": "historical-transcript-replay",
  "displayName": "Transcript Playback",
  "description": "Replay original local chat transcripts in the native VS Code interface without model or tool execution.",
  "version": "0.2.5",
  "publisher": "local",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "chatSessionsProvider",
    "chatParticipantAdditions",
    "defaultChatParticipant"
  ],
  "main": "./native-extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "history-replay.player",
        "name": "replay",
        "fullName": "GitHub Copilot",
        "description": "Local recorded transcript playback",
        "isDefault": true,
        "modes": [
          "ask",
          "agent"
        ],
        "locations": [
          "panel"
        ]
      }
    ],
    "chatSessions": [
      {
        "type": "history-replay",
        "name": "history-replay",
        "displayName": "Recorded conversation",
        "description": "Original local transcripts, no model or tool execution",
        "icon": "$(history)",
        "canDelegate": true
      }
    ],
    "commands": [
      {
        "command": "historyReplay.probe",
        "title": "Replay: Check Native APIs"
      },
      {
        "command": "historyReplay.start",
        "title": "Replay: Start Selected Interaction"
      },
      {
        "command": "historyReplay.pause",
        "title": "Replay: Pause or Resume"
      },
      {
        "command": "historyReplay.step",
        "title": "Replay: Step"
      },
      {
        "command": "historyReplay.stop",
        "title": "Replay: Stop"
      }
    ],
    "keybindings": [
      {
        "command": "historyReplay.start",
        "key": "ctrl+alt+r"
      },
      {
        "command": "historyReplay.pause",
        "key": "ctrl+alt+p"
      },
      {
        "command": "historyReplay.step",
        "key": "ctrl+alt+right"
      },
      {
        "command": "historyReplay.stop",
        "key": "ctrl+alt+s"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "test:unit": "node --test test/replay.test.js test/demo-library.test.js test/history-catalog.test.js test/native-reference.test.js test/updater.test.js",
    "test:references:native": "node test-native.js --references",
    "pretest": "npm run lint",
    "test": "node test-native.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.13.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "playwright": "^1.64.1",
    "ws": "^8.22.0"
  }
}
